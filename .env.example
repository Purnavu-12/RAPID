# ---------------------------------------------------------------------------
# RAPID — environment configuration
#
# Local dev:
#   1. `supabase start`
#   2. `supabase status`            -> copy URL + anon + service_role key below
#   3. `supabase db reset`          -> applies migrations + supabase/seed.sql
#   4. `pnpm dev`
#
# Production (Vercel / other host): set these in the platform dashboard.
# ---------------------------------------------------------------------------

# Supabase project (API + Postgres connection)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_URL=http://localhost:54321

# Public anon key — safe to expose to the browser (subject to Row Level
# Security when enabled). Used by the browser client (lib/supabase/client.ts).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Bypasses RLS, so the dashboard gateway
# (/api/recovery) can read the analytical projections. NEVER expose this to the
# browser.
SUPABASE_SERVICE_ROLE_KEY=

# Demo merchant the dashboard is bound to ("Acme Retail"). Optional: if unset,
# the API resolves the merchant by name. Set this to pin a specific tenant.
RAPID_MERCHANT_ID=

# Razorpay — required to verify inbound webhook signatures (§9 Verify Signature)
# and to drive the dev simulation harness (POST /api/dev/simulate, dev-only).
# For local dev, set any non-empty value; production must use the real secret
# from the Razorpay dashboard. When absent, the webhook receiver rejects
# events with 401 (never silently accepts an unsigned payload — §48).
RAZORPAY_WEBHOOK_SECRET=

# Razorpay API key id (public-ish; used for outbound Payment Link calls once the
# action is scheduled). Not required for signature verification only.
RAZORPAY_KEY_ID=
