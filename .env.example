# ---------------------------------------------------------------------------
# RAPID — environment configuration
#
# Local dev:
#   1. `supabase start`
#   2. `supabase status`            -> copy URL + anon + service_role key below
#   3. `supabase db reset`          -> applies migrations + supabase/seed.sql
#   4. `pnpm dev`
#
# Production (Vercel / other host): set these in the platform dashboard.
# ---------------------------------------------------------------------------

# Supabase project (API + Postgres connection)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_URL=http://localhost:54321

# Public anon key — safe to expose to the browser (subject to Row Level
# Security when enabled). Used by the browser client (lib/supabase/client.ts).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Bypasses RLS, so the dashboard gateway
# (/api/recovery) can read the analytical projections. NEVER expose this to the
# browser.
SUPABASE_SERVICE_ROLE_KEY=

# Demo merchant the dashboard is bound to ("Acme Retail"). Optional: if unset,
# the API resolves the merchant by name. Set this to pin a specific tenant.
RAPID_MERCHANT_ID=

# --- Razorpay (Phase 7: live webhook ingestion) ----------------------------
# API credentials (test or live) — used by lib/razorpay/server.ts to create
# REAL orders / payment links in the dev demo, so dashboard cases carry live
# order_id / payment_link ids instead of synthetic mocks.
RZP_KEY_ID=
RZP_KEY_SECRET=

# Webhook signing secret — HMAC-SHA256 key for x-razorpay-signature (§9 Verify
# Signature). Required by POST /api/webhooks/razorpay (rejects forged events
# with 401 — §48) and by the dev demo (POST /api/dev/simulate signs events
# with this same key so the real verification path is exercised). In the
# Razorpay Dashboard: Settings → Webhooks → add your endpoint URL → set "Secret".
# For the local dev demo you may reuse your test API secret here.
RAZORPAY_WEBHOOK_SECRET=

# --- Execution Plane cron (Phase 9) -----------------------------------------
# Shared secret for POST /api/cron/execute-actions (the §5 scheduler that turns
# SCHEDULED recovery actions into real Razorpay payment links). In dev this is
# dev-only; in production gate the cron URL with `x-rapid-cron-secret` matching
# this value and set `due=` is refused server-side.
RAPID_CRON_SECRET=
